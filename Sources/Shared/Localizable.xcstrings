{
  "sourceLanguage" : "en",
  "strings" : {
    "Applying changes…" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Applying changes…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "변경 사항 적용 중…" } }
      }
    },
    "Accessibility is required. In System Settings > Privacy & Security > Accessibility, enable TidyTapHelper (it may appear as TidyTap). Return here; TidyTap will refresh to confirm access. Then turn your desired feature back on." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility is required. In System Settings > Privacy & Security > Accessibility, enable TidyTapHelper (it may appear as TidyTap). Return here; TidyTap will refresh to confirm access. Then turn your desired feature back on." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "손쉬운 사용 권한이 필요합니다. 시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용에서 TidyTapHelper(목록에는 TidyTap으로 보일 수 있음)를 켜세요. 이 창으로 돌아오면 TidyTap이 권한을 새로 확인합니다. 그 다음 원하는 기능을 다시 켜세요." } }
      }
    },
    "Changes applied." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes applied." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "변경 사항이 적용되었습니다." } }
      }
    },
    "Changes could not be applied." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes could not be applied." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "변경 사항을 적용할 수 없습니다." } }
      }
    },
    "Open TidyTap" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open TidyTap" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "TidyTap 열기" } }
      }
    },
    "Input Monitoring is required. In System Settings > Privacy & Security > Input Monitoring, enable TidyTapHelper (it may appear as TidyTap). Return here; TidyTap will refresh to confirm access. Then turn your desired feature back on." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Input Monitoring is required. In System Settings > Privacy & Security > Input Monitoring, enable TidyTapHelper (it may appear as TidyTap). Return here; TidyTap will refresh to confirm access. Then turn your desired feature back on." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "입력 모니터링 권한이 필요합니다. 시스템 설정 > 개인정보 보호 및 보안 > 입력 모니터링에서 TidyTapHelper(목록에는 TidyTap으로 보일 수 있음)를 켜세요. 이 창으로 돌아오면 TidyTap이 권한을 새로 확인합니다. 그 다음 원하는 기능을 다시 켜세요." } }
      }
    },
