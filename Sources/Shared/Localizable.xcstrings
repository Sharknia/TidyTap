{
  "sourceLanguage" : "en",
  "strings" : {
    "Another TidyTap is running" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Another TidyTap is running" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 TidyTap이 실행 중입니다" } } } },
    "Move TidyTap to Applications and open it from there." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move TidyTap to Applications and open it from there." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "TidyTap을 응용 프로그램 폴더로 옮긴 뒤 거기에서 실행하세요." } } } },
    "Open the installed TidyTap" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the installed TidyTap" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설치된 TidyTap을 실행하세요" } } } },
    "Quit the other copy, then open TidyTap again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quit the other copy, then open TidyTap again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 복사본을 종료한 뒤 TidyTap을 다시 실행하세요." } } } },
    "Check for Updates…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for Updates…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "업데이트 확인…" } } } },
    "Click Start Recording to choose a shortcut." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Click Start Recording to choose a shortcut." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "입력 시작을 눌러 단축키를 지정하세요." } } } },
    "Start Recording" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Recording" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "입력 시작" } } } },
    "Record Again" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record Again" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 입력" } } } },
    "Clear all history" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear all history" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기록 전체 삭제" } } } },
    "Clipboard history was deleted." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clipboard history was deleted." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "클립보드 기록을 모두 삭제했습니다." } } } },
    "Clipboard history could not be deleted." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clipboard history could not be deleted." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "클립보드 기록을 삭제하지 못했습니다." } } } },
    "Delete all clipboard history?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete all clipboard history?" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "클립보드 기록을 모두 삭제할까요?" } } } },
    "This removes saved history. The current clipboard stays unchanged." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This removes saved history. The current clipboard stays unchanged." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 기록만 삭제합니다. 현재 클립보드는 그대로 유지됩니다." } } } },
    "Cancel" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "취소" } } } },
    "Change shortcut" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Change shortcut" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "단축키 변경" } } } },
    "Clipboard history" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clipboard history" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "클립보드 히스토리" } } } },
    "Required for mouse, Finder cut/paste, and clipboard history" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Required for mouse, Finder cut/paste, and clipboard history" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "마우스 기능, Finder 잘라내기, 클립보드 히스토리에 필요" } } } },
    "Clipboard entries" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clipboard entries" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "클립보드 기록" } } } },
    "Copied image preview" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied image preview" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사한 이미지 미리보기" } } } },
    "Copied text preview" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied text preview" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사한 텍스트 미리보기" } } } },
    "Paste image ↵" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Paste image ↵" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미지 붙여넣기 ↵" } } } },
    "Image" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Image" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미지" } } } },
    "No copied items yet" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No copied items yet" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 복사한 항목이 없습니다" } } } },
    "No search results" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No search results" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "검색 결과가 없습니다" } } } },
    "The latest copy exceeded the 10 MiB item limit and was not saved. Select another item from the list." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The latest copy exceeded the 10 MiB item limit and was not saved. Select another item from the list." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "방금 복사한 항목은 저장 한도(항목당 10 MiB)를 넘어 기록하지 않았습니다. 목록에서 다른 항목을 선택하세요." } } } },
    "Paste with formatting ↵  ·  Paste without formatting ⇧↵" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Paste with formatting ↵  ·  Paste without formatting ⇧↵" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "서식 포함 붙여넣기 ↵  ·  서식 없이 ⇧↵" } } } },
    "Paste without formatting ↵  ·  Paste with formatting ⇧↵" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Paste without formatting ↵  ·  Paste with formatting ⇧↵" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "서식 없이 붙여넣기 ↵  ·  서식 포함 ⇧↵" } } } },
    "Search copied text" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search copied text" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사한 텍스트 검색" } } } },
    "Search copied text…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search copied text…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사한 텍스트 검색…" } } } },
    "Searching copied text…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Searching copied text…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "검색 중…" } } } },
    "Clipboard access is denied. Allow TidyTap to read the clipboard, then turn history on again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clipboard access is denied. Allow TidyTap to read the clipboard, then turn history on again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "클립보드 읽기가 거부되었습니다. TidyTap의 읽기를 허용한 뒤 히스토리를 다시 켜세요." } } } },
    "In System Settings, always allow TidyTap to read the clipboard, then turn history on again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "In System Settings, always allow TidyTap to read the clipboard, then turn history on again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "시스템 설정에서 TidyTap의 클립보드 읽기를 항상 허용한 뒤 히스토리를 다시 켜세요." } } } },
    "Clipboard history could not save copied content and was turned off." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clipboard history could not save copied content and was turned off." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사한 내용을 저장하지 못해 클립보드 히스토리를 껐습니다." } } } },
    "TidyTap may read the current clipboard once to check access, without saving it. New copies are saved on this Mac for up to 7 days (100 items, 50 MiB total, 10 MiB each). Turning history off stops collecting new copies; saved items remain until they expire." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TidyTap may read the current clipboard once to check access, without saving it. New copies are saved on this Mac for up to 7 days (100 items, 50 MiB total, 10 MiB each). Turning history off stops collecting new copies; saved items remain until they expire." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "권한 확인을 위해 현재 클립보드를 한 번 읽을 수 있지만 저장하지 않습니다. 기능을 켠 뒤 새로 복사한 내용은 이 Mac에 최대 7일간 보관합니다(최대 100개, 총 50 MiB, 항목당 10 MiB). 기능을 꺼도 기존 기록은 만료될 때까지 남습니다." } } } },
    "Could not paste the selected item" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not paste the selected item" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택한 항목을 붙여넣지 못했습니다" } } } },
    "Could not delete the selected item" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not delete the selected item" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택한 항목을 삭제하지 못했습니다" } } } },
    "Could not open clipboard history" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not open clipboard history" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "클립보드 히스토리를 열지 못했습니다" } } } },
    "Check available storage and try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check available storage and try again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장 공간을 확인한 뒤 다시 시도하세요." } } } },
    "Return to the original input field and try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Return to the original input field and try again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "원래 입력 위치로 돌아가 다시 시도하세요." } } } },
    "The selected history item is no longer available. Reopen history and try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected history item is no longer available. Reopen history and try again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택한 기록이 더는 없습니다. 히스토리를 다시 열어 시도하세요." } } } },
    "TidyTap could not send the paste shortcut. Check Accessibility permission and try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TidyTap could not send the paste shortcut. Check Accessibility permission and try again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "붙여넣기 키를 보내지 못했습니다. 손쉬운 사용 권한을 확인한 뒤 다시 시도하세요." } } } },
    "TidyTap could not write the selected item to the clipboard. Try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TidyTap could not write the selected item to the clipboard. Try again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택한 항목을 클립보드에 쓰지 못했습니다. 다시 시도하세요." } } } },
    "TidyTap Helper did not respond. Reopen history and try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TidyTap Helper did not respond. Reopen history and try again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "TidyTap Helper가 응답하지 않았습니다. 히스토리를 다시 열어 시도하세요." } } } },
    "Default paste" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default paste" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기본 붙여넣기" } } } },
    "Delete" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "삭제" } } } },
    "Press the keys you want to use." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Press the keys you want to use." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용할 키 조합을 누르세요." } } } },
    "Record shortcut" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record shortcut" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "단축키 입력" } } } },
    "Save" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장" } } } },
    "Search and paste copied text and images" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search and paste copied text and images" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사한 텍스트와 이미지 검색·붙여넣기" } } } },
    "Set shortcut" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set shortcut" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "단축키 설정" } } } },
    "Shortcut" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shortcut" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "단축키" } } } },
    "Use Command, Option, or Control with a key." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use Command, Option, or Control with a key." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Command, Option 또는 Control과 다른 키를 함께 누르세요." } } } },
    "With formatting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With formatting" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "서식 포함" } } } },
    "Without formatting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Without formatting" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "서식 없이" } } } },
