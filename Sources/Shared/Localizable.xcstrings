    "Applying changes…" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Applying changes…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "변경 사항 적용 중…" } }
      }
    },
    "Back and forward in Safari and Finder" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Back and forward in Safari and Finder" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Safari · Finder에서 뒤로 및 앞으로" } }
      }
    },
    "Caps Lock input switching" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Caps Lock input switching" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Caps Lock 한·영 전환" } }
      }
    },
    "Cut with ⌘X and move with ⌘V" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cut with ⌘X and move with ⌘V" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "⌘X로 잘라내고 ⌘V로 이동" } }
      }
    },
    "Accessibility is required. In System Settings > Privacy & Security > Accessibility, enable TidyTap. Return here; TidyTap will refresh to confirm access. Then turn your desired feature back on." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility is required. In System Settings > Privacy & Security > Accessibility, enable TidyTap. Return here; TidyTap will refresh to confirm access. Then turn your desired feature back on." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "손쉬운 사용 권한이 필요합니다. 시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용에서 TidyTap를 켜세요. 이 창으로 돌아오면 TidyTap이 권한을 새로 확인합니다. 그 다음 원하는 기능을 다시 켜세요." } }
      }
    },
    "Changes applied." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes applied." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "변경 사항이 적용되었습니다." } }
      }
    },
    "Changes could not be applied." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes could not be applied." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "변경 사항을 적용할 수 없습니다." } }
      }
    },
    "Caps Lock changes need to be restored before you continue." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Caps Lock changes need to be restored before you continue." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "계속하기 전에 Caps Lock 변경 사항을 복원해야 합니다." } }
      }
    },
    "Caps Lock input switching requires exactly two enabled input sources." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Caps Lock input switching requires exactly two enabled input sources." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Caps Lock 한·영 전환에는 활성화된 입력 소스가 정확히 두 개 필요합니다." } }
      }
    },
    "Caps Lock already has a key mapping. Check the existing mapping before trying again." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Caps Lock already has a key mapping. Check the existing mapping before trying again." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Caps Lock에 이미 다른 키 매핑이 있습니다. 기존 매핑을 확인한 뒤 다시 시도하세요." } }
      }
    },
    "TidyTap cannot change the Caps Lock setting because another configuration owns it." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "TidyTap cannot change the Caps Lock setting because another configuration owns it." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 설정이 Caps Lock 관련 키보드 설정을 사용 중이어서 TidyTap이 변경할 수 없습니다." } }
      }
    },
    "TidyTap could not read the current Caps Lock keyboard settings." : {
