        "en" : { "stringUnit" : { "state" : "translated", "value" : "Input Monitoring is required. In System Settings > Privacy & Security > Input Monitoring, enable TidyTap. Return here; TidyTap will refresh to confirm access. Then turn your desired feature back on." } },
